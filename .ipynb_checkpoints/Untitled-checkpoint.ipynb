    "import pandas as pd \n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns \n",
    "\n",
    "data = {\"Days\": [1, 2, 3, 4, 5], \n",
    "        \"Sales\": [100, 20, 350, 400, 500]}\n",
    "\n",
    "data = pd.DataFrame(data)\n",
    "print(data)        \n",
    "\n",
    "sns.lineplot(data=data, x=\"Days\", y=\"Sales\")\n",
    "plt.show()"
   ]
